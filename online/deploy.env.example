# Copia questo file come `.env.deploy` nella cartella principale del repository.
# `.env.deploy` è già ignorato da .gitignore: non verrà mai committato.

DEPLOY_HOST=grimorio.tecnogenitori.com
DEPLOY_USER=ubuntu
DEPLOY_PORT=22
# Facoltativo: percorso della chiave privata SSH (relativo alla root del repo o assoluto).
# Lascia vuoto se usi l'agente SSH o le chiavi predefinite di ~/.ssh/
DEPLOY_KEY=private_key.txt
# Prefisso per eseguire update.sh sulla VPS ("sudo" per utenti normali, vuoto se ti colleghi come root)
DEPLOY_SUDO=sudo
# Cartella remota temporanea per l'upload (default: ~)
DEPLOY_REMOTE_DIR=~
